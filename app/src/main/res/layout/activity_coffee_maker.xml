<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Coffee Cup Icon -->
        <TextView
            android:id="@+id/tv_cup_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/coffee_cup_icon"
            android:textSize="72sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/status_idle"
            android:textSize="16sp"
            android:textColor="@color/coffee_brown"
            android:gravity="center"
            android:minLines="2"
            app:layout_constraintTop_toBottomOf="@id/tv_cup_icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Brew progress -->
        <ProgressBar
            android:id="@+id/progress_brew"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:visibility="invisible"
            android:progressTint="@color/coffee_brown"
            android:progressBackgroundTint="@color/coffee_light"
            app:layout_constraintTop_toBottomOf="@id/tv_status"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Divider -->
        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/coffee_light"
            app:layout_constraintTop_toBottomOf="@id/progress_brew"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

        <!-- Coffee type label -->
        <TextView
            android:id="@+id/tv_type_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_coffee_type"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/coffee_dark"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp" />

        <!-- Coffee type radio group -->
        <RadioGroup
            android:id="@+id/rg_coffee_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tv_type_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rb_espresso"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/coffee_espresso"
                android:textSize="15sp"
                android:textColor="@color/coffee_dark"
                android:buttonTint="@color/coffee_brown"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_cappuccino"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/coffee_cappuccino"
                android:textSize="15sp"
                android:textColor="@color/coffee_dark"
                android:buttonTint="@color/coffee_brown" />

            <RadioButton
                android:id="@+id/rb_latte"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/coffee_latte"
                android:textSize="15sp"
                android:textColor="@color/coffee_dark"
                android:buttonTint="@color/coffee_brown" />

            <RadioButton
                android:id="@+id/rb_americano"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/coffee_americano"
                android:textSize="15sp"
                android:textColor="@color/coffee_dark"
                android:buttonTint="@color/coffee_brown" />

        </RadioGroup>

        <!-- Divider -->
        <View
            android:id="@+id/divider2"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/coffee_light"
            app:layout_constraintTop_toBottomOf="@id/rg_coffee_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Size label -->
        <TextView
            android:id="@+id/tv_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_size"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/coffee_dark"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            app:layout_constraintTop_toBottomOf="@id/divider2"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp" />

        <!-- Size radio group -->
        <RadioGroup
            android:id="@+id/rg_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_size_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rb_small"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/size_small"
                android:textSize="15sp"
                android:textColor="@color/coffee_dark"
                android:buttonTint="@color/coffee_brown"
                android:gravity="center_vertical" />

            <RadioButton
                android:id="@+id/rb_medium"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/size_medium"
                android:textSize="15sp"
                android:textColor="@color/coffee_dark"
                android:buttonTint="@color/coffee_brown"
                android:checked="true"
                android:gravity="center_vertical" />

            <RadioButton
                android:id="@+id/rb_large"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/size_large"
                android:textSize="15sp"
                android:textColor="@color/coffee_dark"
                android:buttonTint="@color/coffee_brown"
                android:gravity="center_vertical" />

        </RadioGroup>

        <!-- Brew Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_brew"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="@string/btn_brew"
            android:textSize="18sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/coffee_brown"
            app:layout_constraintTop_toBottomOf="@id/rg_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="32dp" />

        <!-- Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_coffee"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/btn_brew_again"
            android:textSize="15sp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:strokeColor="@color/coffee_brown"
            android:textColor="@color/coffee_brown"
            app:cornerRadius="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btn_brew"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- bottom spacing -->
        <Space
            android:layout_width="0dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@id/btn_reset_coffee"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
